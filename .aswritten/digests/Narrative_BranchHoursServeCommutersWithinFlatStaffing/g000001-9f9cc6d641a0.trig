    narr:keyPhrase [ narr:text "We open at eight on Tuesdays and Thursdays so the commuter crowd can return books on the way in." ; narr:phraseSource <https://aswritten.ai/narrative#Position_TuesdayThursdayHoursTradeoff> ] ;
    narr:keyPhrase [ narr:text "And we close an hour earlier those days to keep the staffing flat." ; narr:phraseSource <https://aswritten.ai/narrative#Position_TuesdayThursdayHoursTradeoff> ] ;
    narr:variation [ narr:text "The position itself carries the tension: the hours serve commuters only by shortening the same days' service window to hold staffing steady — no alternative arrangement (later close, shifted shifts) appears in the graph yet." ; narr:over <https://aswritten.ai/narrative#Position_TuesdayThursdayHoursTradeoff> ] ;
