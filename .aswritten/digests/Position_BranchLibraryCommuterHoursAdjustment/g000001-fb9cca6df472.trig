    narr:narration """This position holds a concrete, already-in-practice arrangement rather than a proposal: [Tuesday and Thursday openings at eight serve commuters returning books on the way in](narr:Expr_20261009_5_Batch5Library20261009041528_h34aa0f76f126_1), and [those same days close an hour earlier to keep staffing flat](narr:Expr_20261009_5_Batch5Library20261009041528_h34aa0f76f126_2). Both members are voiced as settled decisions with equal-footing framing — the commuter accommodation and the staffing constraint are two halves of one trade, not competing claims.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261009_5_Batch5Library20261009041528_h34aa0f76f126_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261009_5_Batch5Library20261009041528_h34aa0f76f126_2> ;
    narr:keyPhrase [ narr:text "We open at eight on Tuesdays and Thursdays so the commuter crowd can return books on the way in." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261009_5_Batch5Library20261009041528_h34aa0f76f126_1> ] ;
    narr:keyPhrase [ narr:text "And we close an hour earlier those days to keep the staffing flat." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261009_5_Batch5Library20261009041528_h34aa0f76f126_2> ] ;
    narr:variation [ narr:text "The early close qualifies the commuter accommodation — the hours that help morning returns cut evening access the same days, an unresolved trade within the position itself." ; narr:over <https://aswritten.ai/narrative#Expr_20261009_5_Batch5Library20261009041528_h34aa0f76f126_1> ; narr:over <https://aswritten.ai/narrative#Expr_20261009_5_Batch5Library20261009041528_h34aa0f76f126_2> ] ;
