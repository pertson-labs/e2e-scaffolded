    narr:keyPhrase [ narr:text "The weekend timetable stays as it is; Friday and Saturday late sailings still fill." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261009_4_Batch4FerryFrontmatter20261009041528_hf592dd2b25e2_2> ] ;
    narr:variation [ narr:text "The two children pull in opposite temporal directions: one cuts service on observed weekday demand, the other preserves weekend service against the same empirical logic." ; narr:over <https://aswritten.ai/narrative#Expr_20261009_4_Batch4FerryFrontmatter20261009041528_hf592dd2b25e2_1> ; narr:over <https://aswritten.ai/narrative#Expr_20261009_4_Batch4FerryFrontmatter20261009041528_hf592dd2b25e2_2> ] ;
