    narr:generatedFrom "9c2744b4b0da61c95480afdc9a39c0b0a90f14e1" ;
    narr:narration """This position holds that a design ruling stays local until tested: [nothing is exported to other sessions as a build input until the design is tested](narr:Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_2), extending an earlier [frame-index ruling](narr:Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_1). The turn came when [Scarlet stopped the practice of passing the 10/08 ruling onward](narr:Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_3), saying [the core session must do the full design and test it before ad hoc implementation](narr:Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_4). The consequence: [the prompt inventory is parked until the design is solid, then done as one rewrite](narr:Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_53).""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_53> ;
    narr:keyPhrase [ narr:text "Nothing here is exported to other sessions as a build input until the design is tested; Scarlet's 2026-10-09 rule." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_2> ] ;
    narr:keyPhrase [ narr:text "we need to slow down. This is a new conversation, so previous things I said, like this ruling on 766, I don't think are something that we should be passing off to other sessions yet." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_4> ] ;
    narr:keyPhrase [ narr:text "The prompt inventory across all surfaces is parked until the design is solid and implemented, then done as one rewrite." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_53> ] ;
    narr:keyPhrase [ narr:text "The 10/08 ruling had been passed to other sessions as rulings. Scarlet stopped that:" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_3> ] ;
    narr:variation [ narr:text "The position reverses an earlier practice — the 10/08 ruling had already been handed to other sessions before Scarlet halted the export." ; narr:over <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_3> ; narr:over <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_4> ] ;
    narr:variation [ narr:text "The narrator's own earlier framing (2026-10-08) is the thing being walked back, so the position qualifies the very ruling it extends." ; narr:over <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_1> ] ;
