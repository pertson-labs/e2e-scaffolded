    narr:variation [ narr:text "The blanket frost deadline and the loss-based bay prioritization are two different scheduling rationales coexisting in one sequence — the deadline governs scope, the seedling loss governs order." ; narr:over <https://aswritten.ai/narrative#Expr_20261009_2_Batch1Greenhouse20261009050853_hf6ea0fc7e73d_1> ; narr:over <https://aswritten.ai/narrative#Expr_20261009_2_Batch1Greenhouse20261009050853_hf6ea0fc7e73d_2> ] ;
