GRAPH <https://aswritten.ai/narrative#Digest_Narrative_ProveDesignOnAnOracleBeforeItSpreads> {
  <https://aswritten.ai/narrative#Digest_Narrative_ProveDesignOnAnOracleBeforeItSpreads> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Narrative_ProveDesignOnAnOracleBeforeItSpreads> ;
    narr:childCount "4"^^xsd:integer ;
    narr:generatedFrom "9c2744b4b0da61c95480afdc9a39c0b0a90f14e1" ;
    narr:narration """This narrative holds a design back until tested, and asks what reference it is scored against. [A ruling that nothing is exported to other sessions until the design is tested](narr:Position_DesignBeforeExport) sets the gate. [Recall results scored at the unit of expand](narr:Position_FrameRecallTestResults) supply the numbers behind it. [The rejection of production's own placements as the scoring target, replaced by an independently judged set](narr:Position_RightReferenceForRecall) answers the reference question. [The argument that steering is ours to build but recall belongs to a mature engine](narr:Position_SteeringOursRecallFromEngine) qualifies how far the roll-your-own stance goes.""" ;
    narr:covers <https://aswritten.ai/narrative#Position_DesignBeforeExport> ;
    narr:covers <https://aswritten.ai/narrative#Position_FrameRecallTestResults> ;
    narr:covers <https://aswritten.ai/narrative#Position_RightReferenceForRecall> ;
    narr:covers <https://aswritten.ai/narrative#Position_SteeringOursRecallFromEngine> ;
    narr:keyPhrase [ narr:text "Nothing here is exported to other sessions as a build input until the design is tested" ; narr:phraseSource <https://aswritten.ai/narrative#Position_DesignBeforeExport> ] ;
    narr:keyPhrase [ narr:text "narrative pages alone cost 6 to 14K tokens per document while call pages are 90 percent of the weight" ; narr:phraseSource <https://aswritten.ai/narrative#Position_FrameRecallTestResults> ] ;
    narr:keyPhrase [ narr:text "trusting the small models there is something we want to do by confirmation, not faith" ; narr:phraseSource <https://aswritten.ai/narrative#Position_RightReferenceForRecall> ] ;
    narr:keyPhrase [ narr:text "Re-implementing or creating a new database is a generally known stupid thing to do unless what you're trying to do is build a database." ; narr:phraseSource <https://aswritten.ai/narrative#Position_SteeringOursRecallFromEngine> ] ;
    narr:variation [ narr:text "The scoring reference itself is contested: production's own placements were rejected as the target in favor of an independently judged set." ; narr:over <https://aswritten.ai/narrative#Position_RightReferenceForRecall> ; narr:over <https://aswritten.ai/narrative#Position_FrameRecallTestResults> ] ;
    narr:variation [ narr:text "A push against the build-it-ourselves arc: rolling a custom store became an accidental query engine, and recall may belong to a mature one." ; narr:over <https://aswritten.ai/narrative#Position_SteeringOursRecallFromEngine> ] ;
    narr:variation [ narr:text "The recall results are mixed across arms and document shapes — frames alone beat full expansion in one arm, calls read weakly, and one model ran away uncapped." ; narr:over <https://aswritten.ai/narrative#Position_FrameRecallTestResults> ] ;
    narr:run "789d53ecf878" ;
    narr:moved "true"^^xsd:boolean ;
    narr:diffBasis "first" ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}