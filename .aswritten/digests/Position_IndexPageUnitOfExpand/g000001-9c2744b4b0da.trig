GRAPH <https://aswritten.ai/narrative#Digest_Position_IndexPageUnitOfExpand> {
  <https://aswritten.ai/narrative#Digest_Position_IndexPageUnitOfExpand> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Position_IndexPageUnitOfExpand> ;
