    narr:variation [ narr:text "One member states the observed pattern; the other moves straight to a staffing directive — evidence versus prescription, with no one weighing whether weekday evenings should be retried before being cut." ; narr:over <https://aswritten.ai/narrative#Expr_20261014_1_Batch3Rota20261014023839_h27ddd40e3549_1> ; narr:over <https://aswritten.ai/narrative#Expr_20261014_1_Batch3Rota20261014023839_h27ddd40e3549_2> ] ;
