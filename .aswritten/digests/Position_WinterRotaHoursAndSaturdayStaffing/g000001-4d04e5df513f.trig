    narr:keyPhrase [ narr:text "\"The tool library opens Saturdays only through winter. Weekday evenings drew four borrowers in six weeks.\"" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261014_1_Batch3Rota20261014023839_h27ddd40e3549_1> ] ;
