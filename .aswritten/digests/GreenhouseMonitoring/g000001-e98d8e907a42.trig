GRAPH <https://aswritten.ai/narrative#Digest_GreenhouseMonitoring> {
  <https://aswritten.ai/narrative#Digest_GreenhouseMonitoring> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#GreenhouseMonitoring> ;
