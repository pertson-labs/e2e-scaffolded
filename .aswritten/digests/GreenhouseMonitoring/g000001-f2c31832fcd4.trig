    narr:covers <https://aswritten.ai/narrative#Narrative_SensorReportingCadence> ;
    narr:keyPhrase [ narr:text "We install humidity sensors in all four greenhouse bays before the first frost." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261009_2_Batch1Greenhouse20261009050853_hf6ea0fc7e73d_1> ] ;
    narr:keyPhrase [ narr:text "Bay two gets the pilot unit first, because it lost the most seedlings last winter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261009_2_Batch1Greenhouse20261009050853_hf6ea0fc7e73d_2> ] ;
    narr:keyPhrase [ narr:text "The sensors report every fifteen minutes; anything slower misses the overnight drop." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261009_2_Batch1Greenhouse20261009050853_hf6ea0fc7e73d_4> ] ;
    narr:variation [ narr:text "The cadence claim is asserted as expert fact while the rollout plan rests on loss-history persuasion — two different grounds for the same safeguard, and the agreement line ratifies the plan without touching the cadence question." ; narr:over <https://aswritten.ai/narrative#Expr_20261009_2_Batch1Greenhouse20261009050853_hf6ea0fc7e73d_2> ; narr:over <https://aswritten.ai/narrative#Expr_20261009_2_Batch1Greenhouse20261009050853_hf6ea0fc7e73d_3> ; narr:over <https://aswritten.ai/narrative#Expr_20261009_2_Batch1Greenhouse20261009050853_hf6ea0fc7e73d_4> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "decision-forward — plans are voiced as settled commitments, with one bare ratification and one plain claim alongside" ; narr:text "Bay two gets the pilot unit first, because it lost the most seedlings last winter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261009_2_Batch1Greenhouse20261009050853_hf6ea0fc7e73d_2> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "persuasion by rationale and expertise rather than command — the sequencing is argued, the cadence is grounded in technical necessity" ; narr:text "The sensors report every fifteen minutes; anything slower misses the overnight drop." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261009_2_Batch1Greenhouse20261009050853_hf6ea0fc7e73d_4> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete and deadline-driven — future-dated plans sit beside present-tense technical facts" ; narr:text "We install humidity sensors in all four greenhouse bays before the first frost." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261009_2_Batch1Greenhouse20261009050853_hf6ea0fc7e73d_1> ] ;
