    narr:covers <https://aswritten.ai/narrative#Expr_20261009_2_Batch1Greenhouse20261009050853_hf6ea0fc7e73d_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261009_2_Batch1Greenhouse20261009050853_hf6ea0fc7e73d_4> ;
