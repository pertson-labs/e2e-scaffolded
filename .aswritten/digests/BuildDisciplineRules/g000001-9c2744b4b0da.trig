@prefix narr: <https://aswritten.ai/narrative#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

GRAPH <https://aswritten.ai/narrative#Digest_BuildDisciplineRules> {
  <https://aswritten.ai/narrative#Digest_BuildDisciplineRules> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#BuildDisciplineRules> ;
    narr:childCount "6"^^xsd:integer ;
    narr:generatedFrom "9c2744b4b0da61c95480afdc9a39c0b0a90f14e1" ;
    narr:narration """This stratum holds three build-discipline rules, each carried by a general statement and a position that grounds it. [Extend existing work before rolling your own](narr:Position_ExtendBeforeBuildingNew) sits on [the general stance](narr:Narrative_ExtendExistingWorkBeforeRollingOwn). [Test a design on a judged oracle before it spreads](narr:Position_DesignBeforeExport) rests on [the testing rule](narr:Narrative_ProveDesignOnAnOracleBeforeItSpreads). And [output caps as circuit breakers, not length control](narr:Position_OutputCapPolicy) grounds [the cap rule](narr:Narrative_OutputCapsAreRunawayBreakersNotLengthControl).""" ;
    narr:covers <https://aswritten.ai/narrative#Narrative_ExtendExistingWorkBeforeRollingOwn> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_OutputCapsAreRunawayBreakersNotLengthControl> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_ProveDesignOnAnOracleBeforeItSpreads> ;
    narr:covers <https://aswritten.ai/narrative#Position_DesignBeforeExport> ;
    narr:covers <https://aswritten.ai/narrative#Position_ExtendBeforeBuildingNew> ;
    narr:covers <https://aswritten.ai/narrative#Position_OutputCapPolicy> ;
    narr:keyPhrase [ narr:text "The rule is written into `.claude/rules/extend-first.md`." ; narr:phraseSource <https://aswritten.ai/narrative#Position_ExtendBeforeBuildingNew> ] ;
    narr:keyPhrase [ narr:text "Nothing here is exported to other sessions as a build input until the design is tested; Scarlet's 2026-10-09 rule." ; narr:phraseSource <https://aswritten.ai/narrative#Position_DesignBeforeExport> ] ;
    narr:keyPhrase [ narr:text "an output cap, if anything, should be solely for runaway behavior and it should be like a circuit breaker" ; narr:phraseSource <https://aswritten.ai/narrative#Position_OutputCapPolicy> ] ;
    narr:keyPhrase [ narr:text "A design is tested against a judged oracle before it is exported or built in" ; narr:phraseSource <https://aswritten.ai/narrative#Narrative_ProveDesignOnAnOracleBeforeItSpreads> ] ;
    narr:variation [ narr:text "The cap rule carries counter-evidence alongside the principle: one model ran away when uncapped and lost calls while another never hit a limit — the breaker framing is tested, not assumed." ; narr:over <https://aswritten.ai/narrative#Position_OutputCapPolicy> ] ;
    narr:variation [ narr:text "The extend-first rule names a recurring failure mode — distrust of pre-made components and 'cowboyism' — so the rule is a correction of observed behavior, not a neutral preference." ; narr:over <https://aswritten.ai/narrative#Position_ExtendBeforeBuildingNew> ] ;
    narr:run "789d53ecf878" ;
    narr:moved "true"^^xsd:boolean ;
    narr:diffBasis "first" ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}