    narr:keyPhrase [ narr:text "Weekday evenings drew four borrowers in six weeks." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261009_6_Batch3Rota20261009050853_h8a4eacef57e3_2> ] ;
