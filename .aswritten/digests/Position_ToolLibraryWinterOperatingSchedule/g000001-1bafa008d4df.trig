    narr:variation [ narr:text "The staffing addition is stated as future irrealis — a decision not yet witnessed in operation, unlike the past-tense demand evidence behind the schedule cut." ; narr:over <https://aswritten.ai/narrative#Expr_20261009_6_Batch3Rota20261009050853_h8a4eacef57e3_3> ; narr:over <https://aswritten.ai/narrative#Expr_20261009_6_Batch3Rota20261009050853_h8a4eacef57e3_2> ] ;
