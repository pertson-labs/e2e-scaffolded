GRAPH <https://aswritten.ai/narrative#Digest_Position_FerryLateSailingsFollowRidership> {
  <https://aswritten.ai/narrative#Digest_Position_FerryLateSailingsFollowRidership> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Position_FerryLateSailingsFollowRidership> ;
    narr:childCount "2"^^xsd:integer ;
    narr:generatedFrom "e234d3fab357d0a099dff5b17d028da470ba5367" ;
    narr:narration """This position holds that late ferry sailings should be judged by actual ridership. [The weekday last ferry moves earlier from November, justified by under ten passengers a night](narr:Expr_20261014_2_Batch4FerryFrontmatter20261014023839_h513316ce7302_1), while [the weekend timetable stays untouched because Friday and Saturday late sailings still fill](narr:Expr_20261014_2_Batch4FerryFrontmatter20261014023839_h513316ce7302_2).""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261014_2_Batch4FerryFrontmatter20261014023839_h513316ce7302_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261014_2_Batch4FerryFrontmatter20261014023839_h513316ce7302_2> ;
    narr:keyPhrase [ narr:text "The last ferry moves from 22:40 to 21:55 on weekdays from November. The late sailing carried under ten passengers a night." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261014_2_Batch4FerryFrontmatter20261014023839_h513316ce7302_1> ] ;
    narr:keyPhrase [ narr:text "The weekend timetable stays as it is; Friday and Saturday late sailings still fill." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261014_2_Batch4FerryFrontmatter20261014023839_h513316ce7302_2> ] ;
    narr:variation [ narr:text "The ridership criterion cuts the weekday sailing but is not applied to the weekend, where fullness preserves the status quo — the same late sailings are treated by different measures." ; narr:over <https://aswritten.ai/narrative#Expr_20261014_2_Batch4FerryFrontmatter20261014023839_h513316ce7302_1> ; narr:over <https://aswritten.ai/narrative#Expr_20261014_2_Batch4FerryFrontmatter20261014023839_h513316ce7302_2> ] ;
    narr:run "eeba3dd49f8a" ;
    narr:moved "true"^^xsd:boolean ;
    narr:diffBasis "first" ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
