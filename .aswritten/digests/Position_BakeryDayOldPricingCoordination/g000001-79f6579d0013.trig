    narr:keyPhrase [ narr:text "Then the shelf card changes at two as well, so the price is never a surprise at the till." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261009_2_Batch2Bakery20261009041528_hd461484810ba_2> ] ;
