    narr:childCount "2"^^xsd:integer ;
    narr:generatedFrom "91529f55ef5192c08e273b733e36529813e11b41" ;
    narr:narration """This position holds that the late ferry's departure should differ by day of week, grounded in ridership. One member reports [the weekday pull-back to 21:55 from November, citing under ten passengers a night on the late sailing](narr:Expr_20261015_5_Batch4FerryFrontmatter20261015222221_hf9f06b1e6a26_2); the other [keeps the weekend timetable unchanged, with Friday and Saturday late sailings still filling](narr:Expr_20261015_5_Batch4FerryFrontmatter20261015222221_hf9f06b1e6a26_3). Both were voiced the same day, one informational in register, one rationalizing the weekend exception.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261015_5_Batch4FerryFrontmatter20261015222221_hf9f06b1e6a26_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261015_5_Batch4FerryFrontmatter20261015222221_hf9f06b1e6a26_3> ;
    narr:keyPhrase [ narr:text "The last ferry moves from 22:40 to 21:55 on weekdays from November. The late sailing carried under ten passengers a night." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261015_5_Batch4FerryFrontmatter20261015222221_hf9f06b1e6a26_2> ] ;
    narr:keyPhrase [ narr:text "The weekend timetable stays as it is; Friday and Saturday late sailings still fill." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261015_5_Batch4FerryFrontmatter20261015222221_hf9f06b1e6a26_3> ] ;
    narr:variation [ narr:text "The weekday cut rests on thin ridership while the weekend exemption rests on sailings that still fill — the two supports justify by opposite evidence (absence of demand vs. presence of it), leaving any middle days unaddressed." ; narr:over <https://aswritten.ai/narrative#Expr_20261015_5_Batch4FerryFrontmatter20261015222221_hf9f06b1e6a26_2> ; narr:over <https://aswritten.ai/narrative#Expr_20261015_5_Batch4FerryFrontmatter20261015222221_hf9f06b1e6a26_3> ] ;
