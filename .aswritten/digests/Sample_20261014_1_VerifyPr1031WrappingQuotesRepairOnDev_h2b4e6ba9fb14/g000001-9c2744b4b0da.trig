    narr:keyPhrase [ narr:text "we need to slow down." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_4> ] ;
    narr:keyPhrase [ narr:text "We want to return the context around it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_7> ] ;
    narr:keyPhrase [ narr:text "A frame is not designed to be the carrier of meaning." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_25> ] ;
    narr:keyPhrase [ narr:text "the navigator after full expansion recovered 23" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_43> ] ;
    narr:keyPhrase [ narr:text "every consumer composes steering from ours and recall from the engine, never recall from steering" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_51> ] ;
    narr:keyPhrase [ narr:text "the decision on how to frame, how to interpret a frame, is highly context dependent" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_22> ] ;
    narr:variation [ narr:text "Whether a frame alone can locate relevance is left open; Scarlet's answer was only 'maybe', with the claim that the frame-only read is losing something." ; narr:over <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_25> ] ;
    narr:variation [ narr:text "Frames alone in one cheap-model call recovered 26 to 27 of 41 positions, more than the navigator after full expansion (23), though the unit-of-expand figure reached 33 to 37." ; narr:over <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_43> ] ;
    narr:variation [ narr:text "Production's own placements scored poorly as a reference on the judged set, which undercuts the earlier replication target." ; narr:over <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_45> ; narr:over <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_28> ] ;
    narr:variation [ narr:text "The ruled stack is conditional: the hand-rolled ranker, index and fusion retire only if the textbook stack ties or wins on the judged oracle." ; narr:over <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_51> ; narr:over <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_48> ] ;
    narr:variation [ narr:text "The cite prompt may conflict with the statement-as-support rule and is flagged to be ticketed rather than settled here." ; narr:over <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_23> ] ;
    narr:variation [ narr:text "Scarlet questions whether a 355 re-extraction would fix most of the breakdown, and whether it would change things substantially; this remains an unanswered challenge." ; narr:over <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_15> ] ;
    narr:variation [ narr:text "The name of the index and whether a real store is needed are both still open." ; narr:over <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_19> ; narr:over <https://aswritten.ai/narrative#Expr_20261014_1_VerifyPr1031WrappingQuotesRepairOnDev_h2b4e6ba9fb14_54> ] ;
    narr:run "789d53ecf878" ;
    narr:moved "true"^^xsd:boolean ;
    narr:diffBasis "first" ;
    narr:writer "anthropic/claude-haiku-5.5" .
