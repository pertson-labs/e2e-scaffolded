    narr:keyPhrase [ narr:text "The public repair stand goes by the river path entrance, not in the car park. The river path is where the flats happen." ; narr:phraseSource <https://aswritten.ai/narrative#Position_RepairStandSiteAndPumpSecurity> ] ;
    narr:keyPhrase [ narr:text "Put the pump on a chain; the last one walked off in a week." ; narr:phraseSource <https://aswritten.ai/narrative#Position_RepairStandSiteAndPumpSecurity> ] ;
