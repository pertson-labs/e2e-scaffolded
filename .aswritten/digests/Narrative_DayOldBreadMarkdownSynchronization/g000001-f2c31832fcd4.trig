    narr:keyPhrase [ narr:text "Day-old loaves go to half price at two in the afternoon, not at close. At close nobody is left to buy them." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261009_3_Batch2Bakery20261009050853_hff9ef5f7293e_1> ] ;
