    narr:narration """This position pairs an early-opening rationale with a staffing constraint: [the eight o'clock open on Tuesdays and Thursdays serves commuters returning books on the way in](narr:Expr_20261014_6_Batch5Library20261014023839_h47bab630eacd_1), while [closing an hour earlier those days keeps staffing flat](narr:Expr_20261014_6_Batch5Library20261014023839_h47bab630eacd_2). Together they frame the schedule as a trade between commuter access and coverage.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261014_6_Batch5Library20261014023839_h47bab630eacd_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261014_6_Batch5Library20261014023839_h47bab630eacd_2> ;
    narr:keyPhrase [ narr:text "We open at eight on Tuesdays and Thursdays so the commuter crowd can return books on the way in." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261014_6_Batch5Library20261014023839_h47bab630eacd_1> ] ;
    narr:keyPhrase [ narr:text "And we close an hour earlier those days to keep the staffing flat." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261014_6_Batch5Library20261014023839_h47bab630eacd_2> ] ;
    narr:variation [ narr:text "The two statements pull in different value directions — one prioritizes commuter service, the other conservation of staffing — without resolving which governs." ; narr:over <https://aswritten.ai/narrative#Expr_20261014_6_Batch5Library20261014023839_h47bab630eacd_1> ; narr:over <https://aswritten.ai/narrative#Expr_20261014_6_Batch5Library20261014023839_h47bab630eacd_2> ] ;
