    narr:keyPhrase [ narr:text "Day-old loaves go to half price at two in the afternoon, not at close. At close nobody is left to buy them." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261014_4_Batch2Bakery20261014023839_h173c1b0dd019_1> ] ;
    narr:keyPhrase [ narr:text "Then the shelf card changes at two as well, so the price is never a surprise at the till." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261014_4_Batch2Bakery20261014023839_h173c1b0dd019_2> ] ;
