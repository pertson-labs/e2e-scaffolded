    narr:keyPhrase [ narr:text "Nothing here is exported to other sessions as a build input until the design is tested; Scarlet's 2026-10-09 rule." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_4> ] ;
    narr:keyPhrase [ narr:text "we need to slow down. This is a new conversation, so previous things I said, like this ruling on 766, I don't think are something that we should be passing off to other sessions yet." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_6> ] ;
    narr:keyPhrase [ narr:text "If you want a shorter reply, put it in the prompt, but an output cap, if anything, should be solely for runaway behavior and it should be like a circuit breaker." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_34> ] ;
    narr:keyPhrase [ narr:text "Re-implementing or creating a new database is a generally known stupid thing to do unless what you're trying to do is build a database." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_41> ] ;
    narr:keyPhrase [ narr:text "I'd really like us to far more take a standing on the shoulders of giants approach at every step over and over and over again." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_43> ] ;
    narr:keyPhrase [ narr:text "Now a rule in `.claude/rules/llm-calls.md`." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_35> ] ;
    narr:keyPhrase [ narr:text "The rule is written into `.claude/rules/extend-first.md`." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_45> ] ;
    narr:variation [ narr:text "The slowdown directive explicitly retracts an earlier ruling rather than extending it, flagging that prior guidance isn't yet safe to export to other sessions." ; narr:over <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_5> ; narr:over <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_6> ] ;
    narr:variation [ narr:text "The database retrospective concedes the extend-first principle was violated here first, before the shoulders-of-giants directive generalizes it as the rule going forward." ; narr:over <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_41> ; narr:over <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_42> ; narr:over <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_43> ] ;
    narr:variation [ narr:text "The output-cap circuit-breaker rule narrows the discipline to one specific guard against runaway behavior, distinct from the broader extend-and-test gate." ; narr:over <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_34> ; narr:over <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_35> ] ;
