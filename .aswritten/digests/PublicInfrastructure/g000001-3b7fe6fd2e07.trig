    narr:childCount "5"^^xsd:integer ;
    narr:generatedFrom "3b7fe6fd2e07c2de523e3bb8eafd4b4b80230953" ;
    narr:narration """This strata gathers siting and protection decisions for a public repair stand. [Placement at the river path entrance rather than the car park](narr:Expr_20261009_1_Batch6Bikestand20261009050853_hb33a5df833bf_1) rests on [where flats actually happen](narr:Expr_20261009_1_Batch6Bikestand20261009050853_hb33a5df833bf_2), and [tethering the pump after a prior loss](narr:Expr_20261009_1_Batch6Bikestand20261009050853_hb33a5df833bf_3). Two broader narratives frame it: [point-of-need siting over convenience](narr:Narrative_SitingInfrastructureAtPointOfNeed) and [physical safeguards against demonstrated theft](narr:Narrative_SecuringSharedEquipmentAgainstTheft).""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261009_1_Batch6Bikestand20261009050853_hb33a5df833bf_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261009_1_Batch6Bikestand20261009050853_hb33a5df833bf_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261009_1_Batch6Bikestand20261009050853_hb33a5df833bf_3> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_SecuringSharedEquipmentAgainstTheft> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_SitingInfrastructureAtPointOfNeed> ;
    narr:keyPhrase [ narr:text "The public repair stand goes by the river path entrance, not in the car park." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261009_1_Batch6Bikestand20261009050853_hb33a5df833bf_1> ] ;
    narr:keyPhrase [ narr:text "The river path is where the flats happen." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261009_1_Batch6Bikestand20261009050853_hb33a5df833bf_2> ] ;
    narr:keyPhrase [ narr:text "Put the pump on a chain; the last one walked off in a week." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261009_1_Batch6Bikestand20261009050853_hb33a5df833bf_3> ] ;
    narr:variation [ narr:text "Open-access convenience pulls against tethering: securing the pump protects it but adds friction to the same amenity being sited for easy use." ; narr:over <https://aswritten.ai/narrative#Expr_20261009_1_Batch6Bikestand20261009050853_hb33a5df833bf_1> ; narr:over <https://aswritten.ai/narrative#Expr_20261009_1_Batch6Bikestand20261009050853_hb33a5df833bf_3> ] ;
    narr:run "9d4cee2a6acb" ;
    narr:moved "true"^^xsd:boolean ;
    narr:diffBasis "first" ;
