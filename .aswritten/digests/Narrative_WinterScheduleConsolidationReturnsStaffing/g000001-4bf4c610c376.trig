    narr:keyPhrase [ narr:text "The tool library opens Saturdays only through winter. Weekday evenings drew four borrowers in six weeks." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261009_3_Batch3Rota20261009041528_h24ff99af2344_1> ] ;
    narr:keyPhrase [ narr:text "Then the Saturday shift gets a second volunteer to run returns." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261009_3_Batch3Rota20261009041528_h24ff99af2344_2> ] ;
    narr:variation [ narr:text "The two children differ in register: one is evidence-based reporting of the schedule change, the other a directive staffing assignment voiced with authority-ranking framing — no dissent or alternative appears yet." ; narr:over <https://aswritten.ai/narrative#Expr_20261009_3_Batch3Rota20261009041528_h24ff99af2344_1> ; narr:over <https://aswritten.ai/narrative#Expr_20261009_3_Batch3Rota20261009041528_h24ff99af2344_2> ] ;
