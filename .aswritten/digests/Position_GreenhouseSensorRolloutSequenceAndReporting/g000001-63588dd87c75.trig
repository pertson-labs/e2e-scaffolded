    narr:keyPhrase [ narr:text "We install humidity sensors in all four greenhouse bays before the first frost. Bay two gets the pilot unit first, because it lost the most seedlings last winter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261014_5_Batch1Greenhouse20261014023839_h5aba624434d1_1> ] ;
    narr:keyPhrase [ narr:text "Agreed. The sensors report every fifteen minutes; anything slower misses the overnight drop." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261014_5_Batch1Greenhouse20261014023839_h5aba624434d1_2> ] ;
