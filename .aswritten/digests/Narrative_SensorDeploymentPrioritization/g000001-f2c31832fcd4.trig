    narr:keyPhrase [ narr:text "We install humidity sensors in all four greenhouse bays before the first frost." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261009_2_Batch1Greenhouse20261009050853_hf6ea0fc7e73d_1> ] ;
    narr:keyPhrase [ narr:text "Bay two gets the pilot unit first, because it lost the most seedlings last winter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261009_2_Batch1Greenhouse20261009050853_hf6ea0fc7e73d_2> ] ;
