    narr:childCount "2"^^xsd:integer ;
    narr:generatedFrom "8373b46a6c26027b476f4fc906b5275b93ff9d24" ;
    narr:narration """This position holds that late sailings should track the passengers each one actually carries. Its support pairs [a weekday last-sailing cut justified by thin ridership](narr:Expr_20261013_6_Batch4FerryFrontmatter20261013214134_he485688bd4a8_1) with [a weekend carve-out where late sailings still fill](narr:Expr_20261013_6_Batch4FerryFrontmatter20261013214134_he485688bd4a8_2) — a ridership-based rule with a stated exception rather than a blanket change.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261013_6_Batch4FerryFrontmatter20261013214134_he485688bd4a8_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261013_6_Batch4FerryFrontmatter20261013214134_he485688bd4a8_2> ;
    narr:keyPhrase [ narr:text "The last ferry moves from 22:40 to 21:55 on weekdays from November." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261013_6_Batch4FerryFrontmatter20261013214134_he485688bd4a8_1> ] ;
    narr:keyPhrase [ narr:text "The late sailing carried under ten passengers a night." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261013_6_Batch4FerryFrontmatter20261013214134_he485688bd4a8_1> ] ;
    narr:keyPhrase [ narr:text "The weekend timetable stays as it is; Friday and Saturday late sailings still fill." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261013_6_Batch4FerryFrontmatter20261013214134_he485688bd4a8_2> ] ;
    narr:variation [ narr:text "The two supports differ in scope: one changes the weekday schedule, the other argues the weekend should stay untouched — the rule is ridership-based but its application is partial." ; narr:over <https://aswritten.ai/narrative#Expr_20261013_6_Batch4FerryFrontmatter20261013214134_he485688bd4a8_1> ; narr:over <https://aswritten.ai/narrative#Expr_20261013_6_Batch4FerryFrontmatter20261013214134_he485688bd4a8_2> ] ;
