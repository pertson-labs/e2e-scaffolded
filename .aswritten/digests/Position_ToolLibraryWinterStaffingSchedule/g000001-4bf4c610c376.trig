  <https://aswritten.ai/narrative#Digest_Position_ToolLibraryWinterStaffingSchedule> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Position_ToolLibraryWinterStaffingSchedule> ;
    narr:childCount "2"^^xsd:integer ;
    narr:generatedFrom "4bf4c610c376a8605194e860d011a7c5cebfcd4d" ;
    narr:narration """This position holds that the winter schedule narrows to [Saturdays-only opening, backed by six weeks of weekday data](narr:Expr_20261009_3_Batch3Rota20261009041528_h24ff99af2344_1), and pairs it with a [staffing directive to add a second volunteer on Saturdays for returns](narr:Expr_20261009_3_Batch3Rota20261009041528_h24ff99af2344_2). The first member grounds the cutback in observed demand; the second follows it with an assignment voiced as a settled decision.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261009_3_Batch3Rota20261009041528_h24ff99af2344_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261009_3_Batch3Rota20261009041528_h24ff99af2344_2> ;
    narr:keyPhrase [ narr:text "The tool library opens Saturdays only through winter. Weekday evenings drew four borrowers in six weeks." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261009_3_Batch3Rota20261009041528_h24ff99af2344_1> ] ;
    narr:keyPhrase [ narr:text "Then the Saturday shift gets a second volunteer to run returns." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261009_3_Batch3Rota20261009041528_h24ff99af2344_2> ] ;
    narr:variation [ narr:text "The two members rest on different footing: one argues from borrower data, the other assigns staffing by directive — the schedule change is evidenced, the staffing follow-on is not." ; narr:over <https://aswritten.ai/narrative#Expr_20261009_3_Batch3Rota20261009041528_h24ff99af2344_1> ; narr:over <https://aswritten.ai/narrative#Expr_20261009_3_Batch3Rota20261009041528_h24ff99af2344_2> ] ;
    narr:run "c5f92e30700f" ;
    narr:moved "true"^^xsd:boolean ;
    narr:diffBasis "first" ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
