    narr:covers <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_9> ;
    narr:keyPhrase [ narr:text "You want to tightly control the unit of expand." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_9> ] ;
    narr:keyPhrase [ narr:text "We want to return the context around it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_9> ] ;
    narr:keyPhrase [ narr:text "you list the narratives with IRI, and then everything underneath it as just frames." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_10> ] ;
    narr:keyPhrase [ narr:text "I want to see the full package and its edges at the navigational fidelity." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_11> ] ;
    narr:keyPhrase [ narr:text "A long call is one expand result and may spill whole past the bell curve; there is no split." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_13> ] ;
    narr:keyPhrase [ narr:text "The danger there is probably too much data." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_36> ] ;
    narr:variation [ narr:text "The tentative landing (calls as the unit of expansion, frames beneath) is explicitly provisional, not firm." ; narr:over <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_15> ] ;
    narr:variation [ narr:text "An alternative unit is raised — the transaction as the expand unit in the frame index — with too-much-data flagged as its danger, left as an open question." ; narr:over <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_36> ] ;
    narr:variation [ narr:text "Tension between full-package visibility on a document page and the 15K page bound that constrains what can be shown." ; narr:over <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_11> ; narr:over <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_12> ] ;
