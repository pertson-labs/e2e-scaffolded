    narr:generatedFrom "d47e17f24a950a0d71348dc45b695a3faf9b06c6" ;
    narr:narration """This narrative holds a single-dated cluster about whether a build should adapt existing work or roll new code inside given constraints. [A blunt diagnosis that reimplementing a database is a known mistake arrived by accident](narr:Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_41) opens it; [a session-level concession names the hand-rolled read layer as the weak link](narr:Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_42) follows; [a general principle about distrust of pre-made components and a directive to stand on the shoulders of giants](narr:Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_43) generalizes it; and [the rule was written into a rules file](narr:Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_45) closes the arc as a decision.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_41> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_42> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_43> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_45> ;
    narr:keyPhrase [ narr:text "Re-implementing or creating a new database is a generally known stupid thing to do unless what you're trying to do is build a database." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_41> ] ;
    narr:keyPhrase [ narr:text "I'd really like us to far more take a standing on the shoulders of giants approach at every step over and over and over again." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_43> ] ;
    narr:keyPhrase [ narr:text "We're taking a lot of cowboyism." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_43> ] ;
    narr:keyPhrase [ narr:text "The rule is written into `.claude/rules/extend-first.md`." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_45> ] ;
    narr:variation [ narr:text "The concession is bounded: a mature engine adds benchmark-tuned primitives and a declarative query, but not the domain decisions or the oracle — so extend-first is not a blanket rule." ; narr:over <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_42> ] ;
    narr:variation [ narr:text "The general principle is voiced as a critique of AI development broadly, not just this build — a wider indictment than the specific repair it accompanies." ; narr:over <https://aswritten.ai/narrative#Expr_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc_43> ] ;
    narr:run "4e43ac1885e7" ;
    narr:moved "true"^^xsd:boolean ;
    narr:diffBasis "first" ;
