        aswr:qualityFlag "principal:unresolved" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20261011_1_VerifyPr1031WrappingQuotesRepairOnDev_h2e601120d6cc ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Ruled consequences, 2026-10-11: steering stays ours (the perspective load, the frame index pages, the fuzzy edges, the navigator as orientation); recall and precision come from engine primitives, in process first (Lucene BM25 and HNSW over whole positions with parent context, reciprocal rank fusion, SPARQL traversal by unit of expand) and a real RDF store if in-process is not enough; every consumer composes steering from ours and recall from the engine, never recall from steering; the hand-rolled ranker, index and fusion retire if the textbook stack ties or wins on the judged oracle." ;
                oa:prefix "e taking a lot of cowboyism.\n\n" ;
                oa:suffix " The rule is written into `.cl" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "10807"^^xsd:integer ;
                oa:end "11397"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-10-11T22:23:26Z"^^xsd:dateTime .

